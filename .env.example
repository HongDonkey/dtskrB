# Copy these names into your deployment environment.
# Never commit real credentials.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SITE_BASE_URL=https://digivolutionlab.com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digimon_time_stranger
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Recommended in production: a separate account with schema migration privileges.
FLYWAY_DB_USERNAME=your_flyway_username
FLYWAY_DB_PASSWORD=your_flyway_password

# Required as an absolute persistent path in the prod profile.
# Linux example: /var/lib/dtskr/uploads/requests
# Windows example: D:/dtskr-data/uploads/requests
REQUEST_UPLOAD_DIR=/var/lib/dtskr/uploads/requests

# Per-instance request-board abuse protection.
REQUEST_CREATE_RATE_LIMIT=3
REQUEST_CREATE_RATE_WINDOW=10m
REQUEST_LOOKUP_RATE_LIMIT=10
REQUEST_LOOKUP_RATE_WINDOW=5m

# Requester IPs are removed from stored posts after this period.
REQUEST_IP_RETENTION_PERIOD=30d
REQUEST_IP_CLEANUP_INITIAL_DELAY=1m
REQUEST_IP_CLEANUP_INTERVAL=24h

# Required in production. Use a long random value to HMAC daily visitor identifiers.
VISITOR_HASH_SECRET=replace_with_a_long_random_secret

# Required only once when no active ADMIN account exists. Remove the password after bootstrap.
ADMIN_BOOTSTRAP_LOGIN_ID=your_admin_login_id
ADMIN_BOOTSTRAP_PASSWORD=use_a_secret_manager
ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator

# The prod profile defaults this to true. Set false only for local HTTP development.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=30m
